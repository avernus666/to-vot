APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://averna:local-dev-only@localhost:5432/averna?sslmode=disable
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=debug
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Telegram bot integration. Configure all three values to enable the webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MINI_APP_URL=https://your-mini-app.example.com
